{
  "name": "@employee-portal/web",
  "version": "1.4.0",
  "private": true,
  "description": "Enterprise Employee Portal — Angular 18 single-page application",
  "license": "MIT",
  "author": "enterprise-employee-portal contributors",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "ng serve --proxy-config proxy.conf.json",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --coverage --reporters=default --reporters=jest-junit",
    "lint": "ng lint --max-warnings 0",
    "analyze": "ng build --configuration production --stats-json && npx webpack-bundle-analyzer dist/web/stats.json"
  },
  "dependencies": {
    "@angular/animations": "18.2.13",
    "@angular/common": "18.2.13",
    "@angular/compiler": "18.2.13",
    "@angular/core": "18.2.13",
    "@angular/forms": "18.2.13",
    "@angular/platform-browser": "18.2.13",
    "@angular/platform-browser-dynamic": "18.2.13",
    "@angular/router": "18.2.13",
    "rxjs": "7.8.1",
    "tslib": "2.8.1",
    "zone.js": "0.14.10"
  },
  "devDependencies": {
    "@angular-builders/jest": "18.0.0",
    "@angular-devkit/build-angular": "18.2.14",
    "@angular-eslint/builder": "18.4.3",
    "@angular-eslint/eslint-plugin": "18.4.3",
    "@angular-eslint/eslint-plugin-template": "18.4.3",
    "@angular-eslint/schematics": "18.4.3",
    "@angular-eslint/template-parser": "18.4.3",
    "@angular/cli": "18.2.14",
    "@angular/compiler-cli": "18.2.13",
    "@types/jest": "29.5.14",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "autoprefixer": "10.4.20",
    "chokidar": "3.6.0",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "jest-environment-jsdom": "29.7.0",
    "jest-junit": "16.0.0",
    "jest-preset-angular": "14.4.2",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.5.4"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "web-unit.xml"
  }
}
