# ---------------------------------------------------------------------------
# Root environment for docker compose. Copy to `.env` before the first build.
#
#   cp .env.example .env
#   openssl rand -hex 48      # once per secret below
#
# `api/.env.example` covers running the API on the host without Docker.
# ---------------------------------------------------------------------------

NODE_ENV=production

# --- Database --------------------------------------------------------------
DB_NAME=employee_portal
DB_USER=portal
DB_PASSWORD=portal_password
DB_PORT=3306
MYSQL_ROOT_PASSWORD=root_password

# --- Auth secrets (required — compose refuses to start without them) -------
JWT_ACCESS_SECRET=replace_me_with_a_48_byte_hex_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_me_with_a_48_byte_hex_secret_for_refresh_tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- Published ports -------------------------------------------------------
WEB_PORT=3000
API_PORT=4000
ADMINER_PORT=8080

# --- HTTP ------------------------------------------------------------------
# The SPA is served from the web container, so this is the browser origin.
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info

# --- Image coordinates (set by the CI pipeline) ----------------------------
REGISTRY=ghcr.io/<owner>
IMAGE_TAG=latest
