# ---------------------------------------------------------------------------
# Enterprise Employee Portal — API environment
# Copy to `.env` and adjust. Every variable below is validated at boot by
# src/config/env.ts (zod); the process refuses to start on invalid values.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Database (MySQL 8) ----------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_USER=portal
DB_PASSWORD=portal_password
DB_NAME=employee_portal
DB_POOL_MIN=2
DB_POOL_MAX=10

# --- Auth ------------------------------------------------------------------
# Generate with: openssl rand -hex 48
JWT_ACCESS_SECRET=replace_me_with_a_48_byte_hex_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_me_with_a_48_byte_hex_secret_for_refresh_tokens
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

# --- HTTP ------------------------------------------------------------------
CORS_ORIGIN=http://localhost:4200
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- Uploads ---------------------------------------------------------------
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
LOG_DIR=./logs
