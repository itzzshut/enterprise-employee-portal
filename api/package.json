{
  "name": "@employee-portal/api",
  "version": "1.4.0",
  "private": true,
  "description": "Enterprise Employee Portal — REST API (Node.js 22, Express 4, TypeScript, MySQL 8)",
  "license": "MIT",
  "author": "enterprise-employee-portal contributors",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand --ci --coverage --reporters=default --reporters=jest-junit",
    "migrate": "knex --knexfile knexfile.ts migrate:latest",
    "migrate:make": "knex --knexfile knexfile.ts migrate:make -x ts",
    "migrate:rollback": "knex --knexfile knexfile.ts migrate:rollback",
    "migrate:status": "knex --knexfile knexfile.ts migrate:status",
    "seed": "knex --knexfile knexfile.ts seed:run",
    "db:reset": "npm run migrate:rollback -- --all && npm run migrate && npm run seed",
    "test:newman": "newman run ../postman/EmployeePortal.postman_collection.json -e ../postman/EmployeePortal.local.postman_environment.json --reporters cli,htmlextra,junit --reporter-htmlextra-export ../reports/newman/report.html --reporter-junit-export ../reports/newman/junit.xml"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "compression": "1.7.4",
    "cors": "2.8.5",
    "dayjs": "1.11.13",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "knex": "3.1.0",
    "morgan": "1.10.0",
    "multer": "1.4.5-lts.1",
    "mysql2": "3.11.5",
    "swagger-ui-express": "5.0.1",
    "uuid": "11.0.3",
    "winston": "3.17.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/compression": "1.7.5",
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "9.0.7",
    "@types/morgan": "1.9.9",
    "@types/multer": "1.4.12",
    "@types/node": "22.10.2",
    "@types/supertest": "6.0.2",
    "@types/swagger-ui-express": "4.1.7",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "eslint": "8.57.1",
    "jest": "29.7.0",
    "jest-junit": "16.0.0",
    "newman": "6.2.1",
    "newman-reporter-htmlextra": "1.23.1",
    "supertest": "7.0.0",
    "ts-jest": "29.2.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "jest-junit": {
    "outputDirectory": "reports/junit",
    "outputName": "api-unit.xml"
  }
}
